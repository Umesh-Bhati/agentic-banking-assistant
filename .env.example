# Backend: apps/backend/.env. Never expose service role or provider keys to mobile.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"
BANKING_MODE="simulator"
# Independent kill switches; enable only after migrations and synthetic fixtures.
BANKING_MUTATIONS_ENABLED="false"
AI_ENABLED="false"
# Explicit approved provider only. No routing or fallback providers.
APPROVED_AI_PROVIDERS="openai"
AI_MODEL="openai/gpt-4o-mini"
OPENAI_API_KEY=""
PORT="3000"

# Mobile: apps/mobile/.env. Release builds require HTTPS.
EXPO_PUBLIC_API_URL="http://localhost:3000"
