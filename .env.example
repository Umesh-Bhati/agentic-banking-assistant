# Backend: apps/backend/.env. Never expose service role or provider keys to mobile.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"
BANKING_MODE="simulator"
# Independent kill switches; enable only after migrations and synthetic fixtures.
BANKING_MUTATIONS_ENABLED="false"
AI_ENABLED="false"
# Explicit chat provider and model. No automatic fallback to another provider.
APPROVED_AI_PROVIDERS="openrouter"
OPENROUTER_MODEL="openrouter/openai/gpt-4o-mini"
OPENROUTER_API_KEY=""
# Optional direct OpenAI chat: approve openai above and set AI_MODEL instead.
AI_MODEL="openai/gpt-4o-mini"
# Optional embeddings need their own explicit approval; otherwise knowledge search is lexical.
APPROVED_EMBEDDING_PROVIDER=""
OPENAI_API_KEY=""
PORT="3000"

# Mobile: apps/mobile/.env. Release builds require HTTPS.
EXPO_PUBLIC_API_URL="http://localhost:3000"
