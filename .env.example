# ==========================================
# Backend Configuration (apps/backend/.env)
# ==========================================

# Supabase Configuration
# You can find these in your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# AI / LLM Configuration
# Mastra AI framework uses these keys depending on which model you select.
# At least one of these should be provided.
OPENAI_API_KEY="sk-your-openai-api-key"
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key"

# (Optional) Base URL of the backend API, used for generating absolute links (e.g. PDF statement links)
API_URL="http://localhost:3000"


# ==========================================
# Mobile Frontend Configuration (apps/mobile/.env)
# ==========================================

# The base URL where your Fastify backend is running.
# If running on a physical device, use your local network IP instead of localhost (e.g. http://192.168.1.100:3000)
# If running in an iOS simulator, http://localhost:3000 usually works.
# If running in an Android emulator, you may need http://10.0.2.2:3000
EXPO_PUBLIC_API_URL="http://localhost:3000"
