{
  "name": "@boit/backend",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:agent": "vitest run tests/evals/adversarial-agent.eval.test.ts tests/e2e/chat.test.ts tests/unit/agent-boundary.test.ts tests/unit/config.test.ts tests/unit/privacy.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.58",
    "@boit/shared-types": "workspace:*",
    "@mastra/core": "^1.64.0",
    "@mastra/libsql": "^1.22.3",
    "@mastra/observability": "1.17.5",
    "@mastra/rag": "^2.6.1",
    "@supabase/supabase-js": "^2.49.0",
    "ai": "^7.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "pdfkit": "^0.20.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
