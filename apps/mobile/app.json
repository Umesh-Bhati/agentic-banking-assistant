{
  "expo": {
    "name": "boit-mobile",
    "slug": "boit-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "boit-mobile",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ae.almasraf.boit"
    },
    "android": {
      "package": "ae.almasraf.boit",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image"
    ]
  }
}
